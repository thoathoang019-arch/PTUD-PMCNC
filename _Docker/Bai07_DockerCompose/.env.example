# ===========================================================
# File MẪU biến môi trường (.env.example) cho docker-compose
# LƯU Ý: Commit file này lên Git để đồng đội biết cấu trúc
# Copy file này thành file .env và điền mật khẩu thật.
# ===========================================================

# Môi trường chạy
ASPNETCORE_ENVIRONMENT=Production

# Cấu hình Database (PostgreSQL)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=onlineshopdb
DB_HOST=db

# Cấu hình Redis
REDIS_HOST=redis

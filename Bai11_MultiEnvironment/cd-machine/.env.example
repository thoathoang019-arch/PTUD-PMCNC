# ===========================================================
# .env.example — MÁY CD (copy thành .env trên từng máy host)
# ===========================================================
# File .env THẬT nằm trong .gitignore. deploy.sh sẽ cập nhật IMAGE_TAG mỗi lần deploy.

# Registry chung của nhóm (vd Docker Hub user, hoặc registry LAN localhost:5000)
REGISTRY=registry.local:5000
IMAGE_NAME=myapp

# Tag đang chạy. CI/deploy.sh sẽ set giá trị này (vd staging-42). KHÔNG để "latest".
IMAGE_TAG=staging-1

# Môi trường của MÁY NÀY — quyết định file appsettings nào được dùng/mount.
#   Dev CD      -> Development
#   Staging CD  -> Staging
#   Production  -> Production
ASPNETCORE_ENVIRONMENT=Staging

# Đường dẫn file secret THẬT đã đặt sẵn trên máy host (KHÔNG qua Git).
SECRET_FILE=/opt/secrets/appsettings.Staging.json

# Cổng mở ra LAN cho app (nginx).
APP_PORT=8080

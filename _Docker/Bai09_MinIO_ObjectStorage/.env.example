# ============================================================
# Biến môi trường (MẪU) — Bài 09: MinIO Object Storage
# ============================================================
# Copy file này thành .env và điền giá trị thật:
#   cp .env.example .env
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=onlineshopdb
DB_HOST=db

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis

# ── MinIO Object Storage ────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_password_here
MINIO_BUCKET_NAME=online-shop

# ── Cloud Storage (Optional) ────────────────────────────────
# Thay MINIO_ENDPOINT, ACCESS_KEY, SECRET_KEY bằng giá trị cloud
# Xem README.md phần "Chuyển sang Cloud" để biết chi tiết

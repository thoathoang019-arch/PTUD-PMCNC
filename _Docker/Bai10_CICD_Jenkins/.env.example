# ===================================================================
# BIẾN MÔI TRƯỜNG MẪU — BÀI 10: CI/CD VỚI JENKINS
# ===================================================================
# Copy file này thành .env và điền giá trị thật
# cp .env.example .env
# ===================================================================

# === Database ===
POSTGRES_DB=onlineshop
POSTGRES_USER=appuser
POSTGRES_PASSWORD=<mật-khẩu-mạnh>

# === Redis ===
REDIS_PORT=6379

# === App ===
APP_PORT=8080
DB_PORT=5432

# === CI/CD Registry Info ===
# REGISTRY=ghcr.io
# IMAGE_NAME=ghcr.io/<github-username>/online-shop-api
# IMAGE_TAG=latest

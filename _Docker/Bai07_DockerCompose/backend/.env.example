# ===========================================================
# File mau bien moi truong (.env) - dung voi: docker run --env-file .env.example
# Thay vi hard-code connection string, port... trong code,
# ta truyen qua bien moi truong de de dang doi giua dev/test/prod.
# ===========================================================

# Moi truong chay (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Production

# Connection string toi database (thay doi theo tung moi truong)
# Luu y: trong .NET, cau hinh long nhau dung dau __ (2 gach duoi)
#   ConnectionStrings__Default tuong ung ConnectionStrings:Default trong appsettings.json
ConnectionStrings__Default=Server=host.docker.internal;Database=shop;User=app;Password=secret

# Cong ung dung lang nghe (>1024 de user non-root bind duoc)
ASPNETCORE_URLS=http://0.0.0.0:8080
